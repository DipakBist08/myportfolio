# ── Application ───────────────────────────────────────────
APP_NAME=QA Portfolio CMS
APP_ENV=production
DEBUG=false

# ── Database ───────────────────────────────────────────────
# Railway auto-injects DATABASE_URL for Postgres — swap sqlite for prod
DATABASE_URL=sqlite:///./cms.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Security ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_64_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Admin Seed ────────────────────────────────────────────
ADMIN_EMAIL=mbdds54@gmail.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_USERNAME=dipak
ADMIN_FULL_NAME=Dipak Bist

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=https://cms.dipakbist.com.np,https://blog.dipakbist.com.np,https://dipakbist.com.np

# ── File Storage ──────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ── URLs ──────────────────────────────────────────────────
FRONTEND_URL=https://cms.dipakbist.com.np
BACKEND_URL=https://api.dipakbist.com.np

# ── Email (optional) ──────────────────────────────────────
EMAILS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mbdds54@gmail.com
SMTP_PASSWORD=REPLACE_WITH_APP_PASSWORD
EMAILS_FROM_EMAIL=mbdds54@gmail.com
EMAILS_FROM_NAME=Dipak Bist QA Blog

# ── MFA ───────────────────────────────────────────────────
MFA_ISSUER=Dipak Bist QA CMS
